# SmartHR VPS .env — copy to .env and fill in
# DO NOT COMMIT the populated .env

# Postgres (local container)
POSTGRES_DB=recruitment
POSTGRES_USER=smarthr
POSTGRES_PASSWORD=CHANGE_ME_strong_random_pw

# FastAPI session secret (random 64+ chars)
SECRET_KEY=CHANGE_ME_random_64_char_hex_string

# Optional explicit DeepSeek provider. Keep the actual key only in the VPS .env.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=SET_SECURELY_ON_THE_VPS
# DEEPSEEK_MODEL=deepseek-flash

# Shared search-job cap across API workers; retries are bounded at three.
# TASK_MAX_ACTIVE=2
# TASK_MAX_ATTEMPTS=3
