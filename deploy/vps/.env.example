# SmartHR VPS .env — copy to .env and fill in
# DO NOT COMMIT the populated .env

# Postgres (local container)
POSTGRES_DB=recruitment
POSTGRES_USER=smarthr
POSTGRES_PASSWORD=CHANGE_ME_strong_random_pw

# FastAPI session secret (random 64+ chars)
SECRET_KEY=CHANGE_ME_random_64_char_hex_string

# Optional explicit DeepSeek provider. Keep the actual key only in the VPS .env.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=SET_SECURELY_ON_THE_VPS
# DEEPSEEK_MODEL=deepseek-flash

# Shared search-job cap across API workers; retries are bounded at three.
# TASK_MAX_ACTIVE=2
# TASK_MAX_ATTEMPTS=3

# Manual recruiter uploads only; local filesystem/pgvector mode. Pass this into
# the app container's environment (env_file or environment). Set 1 to disable.
# SMARTHR_BULK_EMBED_BATCH_SIZE=8

# Managed desktop pipeline stays off until company devices and fallback are verified.
# Apply the reviewed migration first, then explicitly allowlist tenant IDs.
# SMARTHR_MANAGED_DESKTOP_ENABLED=0
# SMARTHR_MANAGED_DESKTOP_COMPANIES=
