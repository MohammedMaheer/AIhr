FROM python:3.11-slim-bookworm@sha256:94a8fee35252d06ab75856f15f12c7bae67b10e8a6da93c7fded82b2610926cd AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PORT=8080 SMARTHR_LOCAL_MODE=1 SENTENCE_TRANSFORMERS_HOME=/app/.st_cache
WORKDIR /app
COPY requirements.txt requirements-security.txt requirements-vps.txt requirements-runtime.lock.txt ./
RUN python -m pip install --upgrade pip==26.2 setuptools==84.1.0 wheel==0.46.2 \
    && python -m pip install --no-deps --index-url https://download.pytorch.org/whl/cpu torch==2.13.0+cpu \
    && python -m pip install -c requirements-runtime.lock.txt -r requirements.txt -r requirements-vps.txt \
    && python -m pip check

ARG APP_UID=999
ARG APP_GID=999
RUN groupadd --gid ${APP_GID} appuser && useradd --uid ${APP_UID} --gid ${APP_GID} --no-create-home appuser
COPY main.py database.py search_criteria.py llm_prompts.py prompts.py start.sh ./
COPY services/ ./services/
COPY vps_local/ ./vps_local/
COPY templates/ ./templates/
COPY static/ ./static/
RUN mkdir -p logs uploads storage .st_cache \
    && chmod 755 start.sh && chown -R appuser:appuser /app
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=8)"
CMD ["./start.sh"]

FROM runtime AS qa
USER root
RUN python -m pip install pytest==8.4.1 httpx==0.28.1 && python -m pip check
USER appuser
